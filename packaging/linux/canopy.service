# The Canopy controller: device comms, MQTT broker, scheduler, rules, store.
# A boot-level service that the desktop UI connects to over HTTP and never
# owns, so closing the window never stops a light or an irrigation cycle.
#
# Installed by the .deb, .rpm and pacman packages into /usr/lib/systemd/system,
# and by the controller tarball's install.sh into /etc/systemd/system.

[Unit]
Description=Canopy grow controller
Documentation=https://github.com/LASR-0/Canopy
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/opt/Canopy/controller/node --enable-source-maps /opt/Canopy/controller/controller.mjs
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/canopy

# A controller that dies must come back without anyone at the keyboard. A
# deliberate `systemctl stop` is not restarted.
Restart=always
RestartSec=5
# The controller gives itself 30 s to finish work in flight before exiting.
TimeoutStopSec=45

# systemd allocates the account when the service starts, so no package has to
# create a user. StateDirectory keeps /var/lib/canopy (really
# /var/lib/private/canopy) across restarts, upgrades and uninstalls, owned by
# that account and nothing else.
DynamicUser=yes
StateDirectory=canopy
StateDirectoryMode=0700
UMask=0077

# Nothing here needs privilege: 1883 and 7001 are unprivileged ports, and mDNS
# is ordinary multicast UDP. AF_NETLINK is how Node lists network interfaces.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# Not MemoryDenyWriteExecute: V8's JIT writes executable memory.

[Install]
WantedBy=multi-user.target
