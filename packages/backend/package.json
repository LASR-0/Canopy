{
  "name": "@canopy/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OS-managed controller service: device comms, broker, scheduler, rules, store.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@canopy/shared-types": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.2.0",
    "aedes": "^1.0.2",
    "better-sqlite3": "^12.10.0",
    "bonjour-service": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "//deps_note": "Runtime deps (drizzle-orm, better-sqlite3, aedes, bonjour-service, fastify, ws) are added when we wire the service. Versions resolved/verified at install."
}
